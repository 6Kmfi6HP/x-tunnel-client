<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="XTunnelClient.App.MainWindow"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        Title="{Binding T.AppTitle}">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Width" Value="242"/>
      <Setter Property="Height" Value="94"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
          <TextBlock Text="x-tunnel" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding RuntimeStateText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding ErrorText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding AppMessageForeground}" automation:AutomationProperties.AutomationId="AppErrorTextBlock" automation:AutomationProperties.Name="{Binding ErrorText}"/>
        </Grid>
        <Button Grid.Column="1" Content="{Binding T.Connect}" Command="{Binding ConnectCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="ConnectButton"/>
        <Button Grid.Column="2" Content="{Binding T.Disconnect}" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="DisconnectButton"/>
        <Button Grid.Column="3" Content="{Binding T.Restart}" Command="{Binding RestartCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="RestartButton"/>
        <Button Grid.Column="4" Content="{Binding T.Diagnostics}" Command="{Binding OpenDiagnosticsCommand}" automation:AutomationProperties.AutomationId="HeaderDiagnosticsButton"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid ColumnDefinitions="112,1*,50,1.35*,58,1*,70,1*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">
        <TextBlock Text="{Binding ConnectionHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarStateText"/>
        <TextBlock Grid.Column="1" Text="{Binding ActiveProfileSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarProfileText"/>
        <TextBlock Grid.Column="2" Text="{Binding ProxySummary}" Classes="caption" automation:AutomationProperties.AutomationId="StatusBarProxyModeText"/>
        <TextBlock Grid.Column="3" Text="{Binding LocalProxySummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarLocalProxyText"/>
        <TextBlock Grid.Column="4" Text="{Binding T.Traffic}" Classes="caption"/>
        <TextBlock Grid.Column="5" Text="{Binding StatusBarTrafficSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarTrafficText"/>
        <TextBlock Grid.Column="6" Text="{Binding T.Channels}" Classes="caption"/>
        <TextBlock Grid.Column="7" Text="{Binding StatusBarChannelSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarChannelsText"/>
        <TextBlock Grid.Row="1" Text="{Binding T.Core}" Classes="caption"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding CoreSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarCoreText"/>
        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding T.Issue}" Classes="caption"/>
        <TextBlock Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="3" Text="{Binding RecentIssueSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarIssueText"/>
      </Grid>
    </Border>

    <TabControl SelectedIndex="{Binding SelectedMainTabIndex}">
      <TabItem Header="{Binding T.Overview}" automation:AutomationProperties.AutomationId="OverviewTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <Border Classes="panel">
            <Grid ColumnDefinitions="*,360" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ConnectionHeading}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ConnectionDetail}" Classes="caption" automation:AutomationProperties.AutomationId="OverviewConnectionDetailText"/>
                <Grid Margin="0,10,0,0" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="{Binding T.Profile}" Classes="caption"/>
                  <TextBlock Grid.Column="1" Text="{Binding ActiveProfileSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Text="{Binding T.Core}" Classes="caption"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" Text="{Binding T.Proxy}" Classes="caption"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProxySummary}" automation:AutomationProperties.AutomationId="OverviewProxySummaryText"/>
                  <TextBlock Grid.Row="3" Text="{Binding T.Local}" Classes="caption"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalProxySummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="4" Text="{Binding T.Network}" Classes="caption"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                    <Border Background="{Binding NetworkTestBadgeBackground}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding NetworkTestSummary}" Foreground="{Binding NetworkTestBadgeForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkSummaryText"/>
                    </Border>
                    <TextBlock Text="{Binding NetworkTestDetail}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkDetailText"/>
                    <TextBlock Text="{Binding NetworkTestLastRunText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkLastRunText"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Text="{Binding T.Validation}" Classes="caption"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ValidationSummary}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="section" Text="{Binding T.Control}"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberBinding="{Binding Name}" MinHeight="34"/>
                <ComboBox ItemsSource="{Binding ProxyModeOptions}" SelectedItem="{Binding SelectedProxyModeOption}" DisplayMemberBinding="{Binding DisplayName}" MinHeight="34" automation:AutomationProperties.AutomationId="ProxyModeComboBox"/>
                <TextBlock Classes="caption" Text="{Binding T.ProxyMode}"/>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{Binding T.ProxyModeOff}" Command="{Binding SetProxyModeOffCommand}" automation:AutomationProperties.AutomationId="SetProxyModeOffButton"/>
                  <Button Content="{Binding T.ProxyModeSystem}" Command="{Binding SetProxyModeSystemCommand}" automation:AutomationProperties.AutomationId="SetProxyModeSystemButton"/>
                  <Button Content="{Binding T.ProxyModePac}" Command="{Binding SetProxyModePacCommand}" automation:AutomationProperties.AutomationId="SetProxyModePacButton"/>
                </WrapPanel>
                <TextBox Text="{Binding CorePath}" PlaceholderText="{Binding T.CorePathPlaceholder}"/>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{Binding T.Save}" Command="{Binding SaveSettingsCommand}" automation:AutomationProperties.AutomationId="OverviewSaveSettingsButton"/>
                  <Button Content="{Binding T.RestoreProxy}" Command="{Binding RestoreProxyCommand}"/>
                  <Button Content="{Binding T.ProxyAddress}" Command="{Binding CopyProxyCommand}" automation:AutomationProperties.AutomationId="CopyProxyAddressButton"/>
                  <Button Content="{Binding T.CopyStatus}" Command="{Binding CopyOverviewStatusCommand}" automation:AutomationProperties.AutomationId="CopyOverviewStatusButton"/>
                  <Button Content="{Binding T.Restart}" Command="{Binding RestartCommand}"/>
                </WrapPanel>
                <TextBlock Classes="caption" Text="{Binding T.Network}"/>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{Binding T.TestNetwork}" Command="{Binding RunOverviewNetworkTestCommand}" automation:AutomationProperties.AutomationId="OverviewTestNetworkButton"/>
                  <Button Content="{Binding T.Diagnostics}" Command="{Binding OpenDiagnosticsCommand}" automation:AutomationProperties.AutomationId="OverviewOpenDiagnosticsButton"/>
                </WrapPanel>
                <TextBlock Classes="caption" Text="{Binding T.Open}"/>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{Binding T.Profiles}" Command="{Binding OpenProfilesCommand}" automation:AutomationProperties.AutomationId="OpenProfilesButton"/>
                  <Button Content="{Binding T.Subscriptions}" Command="{Binding OpenSubscriptionsCommand}" automation:AutomationProperties.AutomationId="OpenSubscriptionsButton"/>
                  <Button Content="{Binding T.Logs}" Command="{Binding OpenLogsCommand}" automation:AutomationProperties.AutomationId="OpenLogsButton"/>
                  <Button Content="{Binding T.Diagnostics}" Command="{Binding OpenDiagnosticsCommand}" automation:AutomationProperties.AutomationId="OpenDiagnosticsButton"/>
                  <Button Content="{Binding T.Settings}" Command="{Binding OpenSettingsCommand}" automation:AutomationProperties.AutomationId="OpenSettingsButton"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewMetrics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="metric">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="caption"/>
                    <TextBlock Grid.Row="1" Text="{Binding Value}" Classes="metricValue" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="2" ColumnDefinitions="1.1*,1.1*,1.4*" ColumnSpacing="12">
            <Border Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="{Binding T.Listeners}"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ListenerRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="{Binding T.Channels}"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ChannelRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel">
              <Grid RowDefinitions="Auto,*,Auto,120">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="{Binding T.RecentLogs}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="{Binding T.Copy}" Command="{Binding CopyOverviewRecentLogsCommand}" automation:AutomationProperties.AutomationId="CopyOverviewRecentLogsButton"/>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding LogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="OverviewRecentLogsTextBox"/>
                <Grid Grid.Row="2" Margin="0,10,0,6" ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="section" Text="{Binding T.RuntimeDetails}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="{Binding T.Copy}" Command="{Binding CopyOverviewRuntimeDetailsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="CopyOverviewRuntimeDetailsButton"/>
                  <Button Grid.Column="2" Content="{Binding T.CopyMetrics}" Command="{Binding CopyRuntimeMetricsCommand}" automation:AutomationProperties.AutomationId="CopyRuntimeMetricsButton"/>
                </Grid>
                <TextBox Grid.Row="3" Text="{Binding StatusText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="OverviewRuntimeDetailsTextBox"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding T.Profiles}" automation:AutomationProperties.AutomationId="ProfilesTab">
        <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ProfileSearchText}" PlaceholderText="{Binding T.SearchProfiles}" automation:AutomationProperties.AutomationId="ProfileSearchTextBox"/>
                <Button Grid.Column="1" Content="{Binding T.Clear}" Command="{Binding ClearProfileSearchCommand}" automation:AutomationProperties.AutomationId="ClearProfileSearchButton"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Text="{Binding T.Sort}" Classes="caption" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileSortOptions}" SelectedItem="{Binding SelectedProfileSortOption}" DisplayMemberBinding="{Binding DisplayName}" MinHeight="30" automation:AutomationProperties.AutomationId="ProfileSortComboBox"/>
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="{Binding T.New}" Command="{Binding NewProfileCommand}" automation:AutomationProperties.AutomationId="NewProfileButton"/>
                <Button Content="{Binding T.Copy}" Command="{Binding DuplicateProfileCommand}" automation:AutomationProperties.AutomationId="DuplicateProfileButton"/>
                <Button Content="{Binding T.Delete}" Command="{Binding DeleteProfileCommand}" automation:AutomationProperties.AutomationId="DeleteProfileButton"/>
                <Button Content="{Binding T.TestSelected}" Command="{Binding TestSelectedProfileEndpointCommand}" automation:AutomationProperties.AutomationId="TestSelectedProfileButton"/>
                <Button Content="{Binding T.TestVisible}" Command="{Binding TestVisibleProfilesCommand}" automation:AutomationProperties.AutomationId="TestVisibleProfilesButton"/>
                <Button Content="{Binding T.TestFastest}" Command="{Binding TestAndSelectFastestProfileCommand}" automation:AutomationProperties.AutomationId="TestAndSelectFastestProfileButton"/>
                <Button Content="{Binding T.Fastest}" Command="{Binding SelectFastestProfileCommand}" automation:AutomationProperties.AutomationId="SelectFastestProfileButton"/>
                <Button Content="{Binding T.ClearTests}" Command="{Binding ClearVisibleProfileEndpointTestsCommand}" automation:AutomationProperties.AutomationId="ClearEndpointTestsButton"/>
                <Button Content="{Binding T.Startup}" Command="{Binding UseSelectedProfileAtStartupCommand}" automation:AutomationProperties.AutomationId="UseStartupProfileButton"/>
                <Button Content="{Binding T.ClearStartup}" Command="{Binding ClearStartupProfileCommand}" automation:AutomationProperties.AutomationId="ClearStartupProfileButton"/>
              </WrapPanel>
              <TextBlock Text="{Binding StartupProfileSummary}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StartupProfileSummaryTextBlock"/>
              <TextBlock Text="{Binding ProfileBatchTestText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileBatchTestTextBlock"/>
              <TextBlock Text="{Binding ProfileSummaryText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileSummaryTextBlock"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding FilteredProfileRows}" SelectedItem="{Binding SelectedProfileRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileListItemName"/>
                      <Border Grid.Column="1" Background="{Binding ValidationBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding ValidationState}" Foreground="{Binding ValidationBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="ProfileListItemValidationState"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding ListSubtitle}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileListItemSubtitle"/>
                      <Border Grid.Row="1" Grid.Column="1" Background="{Binding EndpointBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding EndpointTestState}" Foreground="{Binding EndpointBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="ProfileListItemEndpointState"/>
                      </Border>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ValidationDetail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding EndpointTestDetail}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileListItemEndpointDetail"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,120,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,160,160" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.Name}" PlaceholderText="{Binding T.ProfileNamePlaceholder}" automation:AutomationProperties.AutomationId="ProfileNameTextBox"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileKinds}" SelectedItem="{Binding SelectedProfileKindOption}" DisplayMemberBinding="{Binding DisplayName}" automation:AutomationProperties.AutomationId="ProfileKindComboBox"/>
              <TextBox Grid.Column="2" Text="{Binding SelectedProfile.Source}" PlaceholderText="{Binding T.SourcePlaceholder}"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding ProfileListen}" PlaceholderText="{Binding T.ProfileListenPlaceholder}" automation:AutomationProperties.AutomationId="ProfileListenTextBox"/>
              <TextBox Grid.Column="1" Text="{Binding ProfileForward}" PlaceholderText="{Binding T.ProfileForwardPlaceholder}" automation:AutomationProperties.AutomationId="ProfileForwardTextBox"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="120,120,*" ColumnSpacing="8">
              <NumericUpDown Value="{Binding ProfileConnections}" Minimum="1" Maximum="32"/>
              <CheckBox Grid.Column="1" IsChecked="{Binding ProfileFallback}" Content="{Binding T.Fallback}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="2" Text="{Binding ProfileMetrics}" PlaceholderText="{Binding T.ProfileMetricsPlaceholder}"/>
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.SecretRef}" PlaceholderText="{Binding T.SecretRefPlaceholder}"/>
              <TextBox Grid.Column="1" Text="{Binding SecretValue}" PasswordChar="*" PlaceholderText="{Binding T.ProfileSecretPlaceholder}" automation:AutomationProperties.AutomationId="ProfileSecretTextBox"/>
            </Grid>
            <WrapPanel Grid.Row="4" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.ApplyForm}" Command="{Binding ApplyFormCommand}" automation:AutomationProperties.AutomationId="ApplyProfileFormButton"/>
              <Button Content="{Binding T.Save}" Command="{Binding SaveProfileCommand}" automation:AutomationProperties.AutomationId="SaveProfileButton"/>
              <Button Content="{Binding T.Validate}" Command="{Binding ValidateProfileCommand}" automation:AutomationProperties.AutomationId="ValidateProfileButton"/>
              <Button Content="{Binding T.Format}" Command="{Binding FormatProfileCommand}" automation:AutomationProperties.AutomationId="FormatProfileButton"/>
              <Button Content="{Binding T.ImportFile}" Click="ImportFile_OnClick"/>
              <Button Content="{Binding T.ImportClipboard}" Click="ImportClipboard_OnClick" automation:AutomationProperties.AutomationId="ImportProfileClipboardButton"/>
              <Button Content="{Binding T.Export}" Click="ExportProfile_OnClick"/>
              <Button Content="{Binding T.CopySummary}" Command="{Binding CopyProfileSummaryCommand}" automation:AutomationProperties.AutomationId="CopyProfileSummaryButton"/>
              <Button Content="{Binding T.CopyConfig}" Command="{Binding CopyProfileConfigCommand}" automation:AutomationProperties.AutomationId="CopyProfileConfigButton"/>
              <Button Content="{Binding T.CopyIssues}" Command="{Binding CopyProfileIssuesCommand}" automation:AutomationProperties.AutomationId="CopyProfileIssuesButton"/>
            </WrapPanel>
            <Border Grid.Row="5" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="{Binding T.ProfileChecks}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding ProfileIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6" ColumnDefinitions="90,80,*">
                          <TextBlock Text="{Binding Field}" Classes="caption"/>
                          <TextBlock Grid.Column="1" Text="{Binding Severity}" Classes="caption"/>
                          <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <TextBox Grid.Row="6" Text="{Binding SelectedProfile.CoreConfigJson}" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="ProfileJsonTextBox"/>
            <TextBlock Grid.Row="7" Text="{Binding SelectedProfile.LastValidationError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding T.Subscriptions}" automation:AutomationProperties.AutomationId="SubscriptionsTab">
        <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
              <TextBox Text="{Binding SubscriptionSearchText}" PlaceholderText="{Binding T.SearchSubscriptions}" automation:AutomationProperties.AutomationId="SubscriptionSearchTextBox"/>
              <Button Grid.Column="1" Content="{Binding T.Clear}" Command="{Binding ClearSubscriptionSearchCommand}" automation:AutomationProperties.AutomationId="ClearSubscriptionSearchButton"/>
            </Grid>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
              <TextBlock Text="{Binding T.Sort}" Classes="caption" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding SubscriptionSortOptions}" SelectedItem="{Binding SelectedSubscriptionSortOption}" DisplayMemberBinding="{Binding DisplayName}" MinHeight="30" automation:AutomationProperties.AutomationId="SubscriptionSortComboBox"/>
            </Grid>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.New}" Command="{Binding NewSubscriptionCommand}" automation:AutomationProperties.AutomationId="NewSubscriptionButton"/>
              <Button Content="{Binding T.Update}" Command="{Binding RefreshSubscriptionCommand}" automation:AutomationProperties.AutomationId="UpdateSubscriptionButton"/>
              <Button Content="{Binding T.UpdateAll}" Command="{Binding RefreshAllSubscriptionsCommand}" automation:AutomationProperties.AutomationId="UpdateAllSubscriptionsButton"/>
              <Button Content="{Binding T.Save}" Command="{Binding SaveSubscriptionCommand}" automation:AutomationProperties.AutomationId="SaveSubscriptionButton"/>
              <Button Content="{Binding T.Delete}" Command="{Binding DeleteSubscriptionCommand}" automation:AutomationProperties.AutomationId="DeleteSubscriptionButton"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionSummaryText}" Classes="caption" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="SubscriptionSummaryTextBlock"/>
            <ListBox ItemsSource="{Binding FilteredSubscriptionRows}" SelectedItem="{Binding SelectedSubscriptionRow}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="SubscriptionListItemName"/>
                      <Border Grid.Column="1" Background="{Binding UpdateBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding UpdateState}" Foreground="{Binding UpdateBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="SubscriptionListItemState"/>
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ListSubtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding UpdateDetail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,150" RowSpacing="10">
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
              <TextBlock Text="{Binding T.Name}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding SelectedSubscription.DisplayName}" PlaceholderText="{Binding T.Name}" automation:AutomationProperties.AutomationId="SubscriptionNameTextBox"/>
              <TextBlock Grid.Row="1" Text="{Binding T.Url}" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSubscription.Url}" PlaceholderText="https://example.com/subscription.json" automation:AutomationProperties.AutomationId="SubscriptionUrlTextBox"/>
              <TextBlock Grid.Row="2" Text="{Binding T.UpdateIntervalMinutes}" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SelectedSubscription.UpdateIntervalMinutes}" Minimum="1" Maximum="10080"/>
              <TextBlock Grid.Row="3" Text="{Binding T.TrustPolicy}" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SubscriptionTrustPolicies}" SelectedItem="{Binding SelectedSubscriptionTrustPolicyOption}" DisplayMemberBinding="{Binding DisplayName}" automation:AutomationProperties.AutomationId="SubscriptionTrustPolicyComboBox"/>
            </Grid>
            <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.UpdateNow}" Command="{Binding RefreshSubscriptionCommand}" automation:AutomationProperties.AutomationId="UpdateSubscriptionNowButton"/>
              <Button Content="{Binding T.UpdateAll}" Command="{Binding RefreshAllSubscriptionsCommand}" automation:AutomationProperties.AutomationId="UpdateAllSubscriptionsNowButton"/>
              <Button Content="{Binding T.SaveSubscription}" Command="{Binding SaveSubscriptionCommand}" automation:AutomationProperties.AutomationId="SaveSubscriptionDetailsButton"/>
              <Button Content="{Binding T.CopySource}" Command="{Binding CopySubscriptionSourceCommand}" automation:AutomationProperties.AutomationId="CopySubscriptionSourceButton"/>
              <Button Content="{Binding T.CopyResult}" Command="{Binding CopySubscriptionStatusCommand}" automation:AutomationProperties.AutomationId="CopySubscriptionStatusButton"/>
            </WrapPanel>
            <TextBox Grid.Row="2" Text="{Binding SubscriptionStatusText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="SubscriptionStatusTextBox"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding T.Logs}" automation:AutomationProperties.AutomationId="LogsTab">
        <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{Binding T.RefreshDiagnostics}" Command="{Binding RefreshDiagnosticsCommand}" automation:AutomationProperties.AutomationId="LogsRefreshDiagnosticsButton"/>
            <Button Content="{Binding T.ExportDiagnostics}" Click="ExportDiagnostics_OnClick" automation:AutomationProperties.AutomationId="ExportDiagnosticsButton"/>
            <ComboBox Width="150" ItemsSource="{Binding LogLevelFilters}" SelectedItem="{Binding SelectedLogLevelFilterOption}" DisplayMemberBinding="{Binding DisplayName}" automation:AutomationProperties.AutomationId="LogLevelFilterComboBox"/>
            <TextBox Width="390" Text="{Binding LogFilterText}" PlaceholderText="{Binding T.FilterLogsPlaceholder}" automation:AutomationProperties.AutomationId="LogFilterTextBox"/>
            <Button Content="{Binding T.ClearFilters}" Command="{Binding ClearLogFiltersCommand}" automation:AutomationProperties.AutomationId="ClearLogFiltersButton"/>
            <Button Content="{Binding T.CopyLogs}" Command="{Binding CopyFilteredLogsCommand}" automation:AutomationProperties.AutomationId="CopyFilteredLogsButton"/>
          </WrapPanel>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Background="{Binding LogFilterBadgeBackground}" CornerRadius="4" Padding="7,2">
              <TextBlock Text="{Binding LogFilterBadgeText}" Foreground="{Binding LogFilterBadgeForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="LogFilterBadgeText"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding LogFilterSummary}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="LogFilterSummaryText"/>
          </Grid>
          <TextBox Grid.Row="2" Text="{Binding FilteredLogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="FilteredLogTextBox"/>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding T.Diagnostics}" automation:AutomationProperties.AutomationId="DiagnosticsTab">
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,88,Auto,Auto,88,132,*" RowSpacing="10">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.RunAll}" Command="{Binding RunAllDiagnosticsCommand}" automation:AutomationProperties.AutomationId="RunAllDiagnosticsButton"/>
              <Button Content="{Binding T.ClearTests}" Command="{Binding ClearDiagnosticsTestsCommand}" automation:AutomationProperties.AutomationId="ClearDiagnosticsTestsButton"/>
              <Button Content="{Binding T.RunChecks}" Command="{Binding RefreshDiagnosticsCommand}" automation:AutomationProperties.AutomationId="RunDiagnosticsButton"/>
              <Button Content="{Binding T.CopySummary}" Command="{Binding CopyDiagnosticsSummaryCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsSummaryButton"/>
              <Button Content="{Binding T.CopyReport}" Command="{Binding CopyDiagnosticsReportCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsReportButton"/>
              <Button Content="{Binding T.ExportZip}" Click="ExportDiagnostics_OnClick" automation:AutomationProperties.AutomationId="ExportDiagnosticsZipButton"/>
              <Button Content="{Binding T.RestoreProxy}" Command="{Binding RestoreProxyCommand}"/>
              <Button Content="{Binding T.OpenLogs}" Command="{Binding OpenLogsFolderCommand}"/>
              <Button Content="{Binding T.CopyPorts}" Command="{Binding CopyDiagnosticsPortsCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsPortsButton"/>
            </WrapPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Border Background="{Binding DiagnosticsPortBackground}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding DiagnosticsPortStatus}" Foreground="{Binding DiagnosticsPortForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsPortStatusText"/>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding DiagnosticsPortDetail}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsPortDetailText"/>
              <TextBlock Grid.Column="2" Text="{Binding DiagnosticsLastRunText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsLastRunText"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="90,*" ColumnSpacing="8">
            <TextBlock Text="{Binding T.Target}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkTestTargets}" SelectedItem="{Binding SelectedNetworkTestTargetOption}" DisplayMemberBinding="{Binding DisplayName}" MinHeight="30" automation:AutomationProperties.AutomationId="NetworkTestTargetComboBox"/>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Text="{Binding T.TestUrl}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding NetworkTestUrl}" automation:AutomationProperties.AutomationId="NetworkTestUrlTextBox"/>
            <WrapPanel Grid.Row="1" Grid.Column="1" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.TestNetwork}" Command="{Binding TestNetworkCommand}" automation:AutomationProperties.AutomationId="TestNetworkButton"/>
              <Button Content="{Binding T.CopyResult}" Command="{Binding CopyNetworkTestResultCommand}" automation:AutomationProperties.AutomationId="CopyNetworkTestResultButton"/>
              <Button Content="{Binding T.Clear}" Command="{Binding ClearNetworkTestCommand}" automation:AutomationProperties.AutomationId="ClearNetworkTestButton"/>
            </WrapPanel>
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Border Background="{Binding NetworkDirectRouteBackground}" CornerRadius="4" Padding="8,5">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding NetworkDirectRouteStatus}" Foreground="{Binding NetworkDirectRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkDirectRouteStatusText"/>
                <TextBlock Grid.Row="1" Text="{Binding NetworkDirectRouteDetail}" Foreground="{Binding NetworkDirectRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkDirectRouteDetailText"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="{Binding NetworkProxyRouteBackground}" CornerRadius="4" Padding="8,5">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding NetworkProxyRouteStatus}" Foreground="{Binding NetworkProxyRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkProxyRouteStatusText"/>
                <TextBlock Grid.Row="1" Text="{Binding NetworkProxyRouteDetail}" Foreground="{Binding NetworkProxyRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkProxyRouteDetailText"/>
              </Grid>
            </Border>
          </Grid>
          <TextBox Grid.Row="4" Text="{Binding NetworkTestText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="NetworkTestResultTextBox"/>
          <WrapPanel Grid.Row="5" ItemSpacing="8" LineSpacing="8">
            <Button Content="{Binding T.TestForward}" Command="{Binding TestProfileEndpointCommand}" automation:AutomationProperties.AutomationId="TestProfileEndpointButton"/>
            <Button Content="{Binding T.CopyForward}" Command="{Binding CopyProfileEndpointTestResultCommand}" automation:AutomationProperties.AutomationId="CopyProfileEndpointTestResultButton"/>
            <Button Content="{Binding T.ClearForward}" Command="{Binding ClearProfileEndpointTestCommand}" automation:AutomationProperties.AutomationId="ClearProfileEndpointTestButton"/>
            <TextBlock Text="{Binding ProfileEndpointTestLastRunText}" Classes="caption" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="ProfileEndpointLastRunText"/>
          </WrapPanel>
          <Border Grid.Row="6" Background="{Binding ProfileEndpointRouteBackground}" CornerRadius="4" Padding="8,5">
            <Grid RowDefinitions="Auto,Auto">
              <TextBlock Text="{Binding ProfileEndpointRouteStatus}" Foreground="{Binding ProfileEndpointRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileEndpointRouteStatusText"/>
              <TextBlock Grid.Row="1" Text="{Binding ProfileEndpointRouteDetail}" Foreground="{Binding ProfileEndpointRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileEndpointRouteDetailText"/>
            </Grid>
          </Border>
          <TextBox Grid.Row="7" Text="{Binding ProfileEndpointTestText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="ProfileEndpointTestResultTextBox"/>
          <TextBox Grid.Row="8" Text="{Binding DiagnosticsSummaryText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="DiagnosticsSummaryTextBox"/>
          <TextBox Grid.Row="9" Text="{Binding DiagnosticsText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="DiagnosticsReportTextBox"/>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding T.Settings}" automation:AutomationProperties.AutomationId="SettingsTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="16" ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
            <TextBlock Text="{Binding T.LaunchAtLogin}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.LaunchAtLogin}"/>
            <TextBlock Grid.Row="1" Text="{Binding T.StartMinimized}" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.StartMinimized}"/>
            <TextBlock Grid.Row="2" Text="{Binding T.AutoConnectSelectedProfile}" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AutoConnectSelectedProfile}" automation:AutomationProperties.AutomationId="SettingsAutoConnectCheckBox"/>
            <TextBlock Grid.Row="3" Text="{Binding T.StartupDelaySeconds}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.StartupDelaySeconds}" Minimum="0" Maximum="120"/>
            <TextBlock Grid.Row="4" Text="{Binding T.Theme}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" DisplayMemberBinding="{Binding DisplayName}" automation:AutomationProperties.AutomationId="ThemeComboBox"/>
            <TextBlock Grid.Row="5" Text="{Binding T.Language}" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="SettingsLanguageLabel"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
              <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberBinding="{Binding DisplayName}" MinHeight="30" automation:AutomationProperties.AutomationId="LanguageComboBox"/>
              <TextBlock Text="{Binding T.LanguageRestartNotRequired}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="LanguageHintText"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Text="{Binding T.PacBypassRules}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.PacBypassRules}"/>
            <TextBlock Grid.Row="7" Text="{Binding T.LogRetentionDays}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Settings.LogRetentionDays}" Minimum="1" Maximum="365"/>
            <TextBlock Grid.Row="8" Text="{Binding T.UpdateChannel}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding SelectedUpdateChannelOption}" DisplayMemberBinding="{Binding DisplayName}" automation:AutomationProperties.AutomationId="UpdateChannelComboBox"/>
            <TextBlock Grid.Row="9" Text="{Binding T.CoreExecutable}" VerticalAlignment="Center"/>
            <Grid Grid.Row="9" Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBox Text="{Binding CorePath}" PlaceholderText="{Binding T.CorePathPlaceholder}" automation:AutomationProperties.AutomationId="SettingsCorePathTextBox"/>
              <Button Grid.Column="1" Content="{Binding T.UseDetected}" Command="{Binding UseDetectedCorePathCommand}" automation:AutomationProperties.AutomationId="UseDetectedCorePathButton"/>
              <Button Grid.Column="2" Content="{Binding T.CheckVersion}" Command="{Binding CheckCoreVersionCommand}" automation:AutomationProperties.AutomationId="CheckCoreVersionButton"/>
              <Button Grid.Column="3" Content="{Binding T.CopyPath}" Command="{Binding CopyCorePathCommand}" automation:AutomationProperties.AutomationId="CopyCorePathButton"/>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding DetectedCorePath}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DetectedCorePathTextBlock"/>
              <Grid Grid.Row="2" Grid.ColumnSpan="4" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Background="{Binding CorePathStatusBackground}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CorePathStatus}" Foreground="{Binding CorePathStatusForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="CorePathStatusText"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CorePathStatusDetail}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="CorePathStatusDetailText"/>
              </Grid>
            </Grid>
            <TextBlock Grid.Row="10" Text="{Binding T.LocalFolders}" VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="10" Grid.Column="1" ItemSpacing="8" LineSpacing="8">
              <Button Content="{Binding T.CopyFolders}" Command="{Binding CopySettingsFoldersCommand}" automation:AutomationProperties.AutomationId="CopySettingsFoldersButton"/>
              <Button Content="{Binding T.AppData}" Command="{Binding OpenDataFolderCommand}"/>
              <Button Content="{Binding T.Profiles}" Command="{Binding OpenProfilesFolderCommand}"/>
              <Button Content="{Binding T.Logs}" Command="{Binding OpenLogsFolderCommand}"/>
              <Button Content="{Binding T.Runtime}" Command="{Binding OpenRuntimeFolderCommand}"/>
            </WrapPanel>
            <Button Grid.Row="11" Grid.Column="1" HorizontalAlignment="Left" Content="{Binding T.SaveSettings}" Command="{Binding SaveSettingsCommand}" automation:AutomationProperties.AutomationId="SaveSettingsButton"/>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
