<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="XTunnelClient.App.MainWindow"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
        Title="x-tunnel Client">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Width" Value="242"/>
      <Setter Property="Height" Value="94"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <Border DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
          <TextBlock Text="x-tunnel" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding RuntimeState}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding ErrorText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" automation:AutomationProperties.AutomationId="AppErrorTextBlock"/>
        </Grid>
        <Button Grid.Column="1" Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="ConnectButton"/>
        <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="DisconnectButton"/>
        <Button Grid.Column="3" Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="RestartButton"/>
        <Button Grid.Column="4" Content="Diagnostics" Command="{Binding OpenDiagnosticsCommand}" automation:AutomationProperties.AutomationId="HeaderDiagnosticsButton"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="12,6">
      <Grid ColumnDefinitions="120,*,90,180,90,260,70,*" ColumnSpacing="8">
        <TextBlock Text="{Binding ConnectionHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarStateText"/>
        <TextBlock Grid.Column="1" Text="{Binding ActiveProfileSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarProfileText"/>
        <TextBlock Grid.Column="2" Text="{Binding ProxySummary}" Classes="caption" automation:AutomationProperties.AutomationId="StatusBarProxyModeText"/>
        <TextBlock Grid.Column="3" Text="{Binding LocalProxySummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarLocalProxyText"/>
        <TextBlock Grid.Column="4" Text="Core" Classes="caption"/>
        <TextBlock Grid.Column="5" Text="{Binding CoreSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarCoreText"/>
        <TextBlock Grid.Column="6" Text="Issue" Classes="caption"/>
        <TextBlock Grid.Column="7" Text="{Binding RecentIssueSummary}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StatusBarIssueText"/>
      </Grid>
    </Border>

    <TabControl SelectedIndex="{Binding SelectedMainTabIndex}">
      <TabItem Header="Overview" automation:AutomationProperties.AutomationId="OverviewTab">
        <ScrollViewer>
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
          <Border Classes="panel">
            <Grid ColumnDefinitions="*,360" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ConnectionHeading}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ConnectionDetail}" Classes="caption"/>
                <Grid Margin="0,10,0,0" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Profile" Classes="caption"/>
                  <TextBlock Grid.Column="1" Text="{Binding ActiveProfileSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Text="Core" Classes="caption"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" Text="Proxy" Classes="caption"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProxySummary}" automation:AutomationProperties.AutomationId="OverviewProxySummaryText"/>
                  <TextBlock Grid.Row="3" Text="Local" Classes="caption"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalProxySummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="4" Text="Network" Classes="caption"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                    <Border Background="{Binding NetworkTestBadgeBackground}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding NetworkTestSummary}" Foreground="{Binding NetworkTestBadgeForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkSummaryText"/>
                    </Border>
                    <TextBlock Text="{Binding NetworkTestDetail}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkDetailText"/>
                    <TextBlock Text="{Binding NetworkTestLastRunText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="OverviewNetworkLastRunText"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Text="Validation" Classes="caption"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ValidationSummary}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="section" Text="Control"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberBinding="{Binding Name}" MinHeight="34"/>
                <ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding SelectedProxyMode}" MinHeight="34"/>
                <TextBlock Classes="caption" Text="Proxy mode"/>
                <WrapPanel>
                  <Button Content="Off" Command="{Binding SetProxyModeOffCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="SetProxyModeOffButton"/>
                  <Button Content="System" Command="{Binding SetProxyModeSystemCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="SetProxyModeSystemButton"/>
                  <Button Content="PAC" Command="{Binding SetProxyModePacCommand}" automation:AutomationProperties.AutomationId="SetProxyModePacButton"/>
                </WrapPanel>
                <TextBox Text="{Binding CorePath}" PlaceholderText="Auto-detect or full path to x-tunnel.exe"/>
                <WrapPanel>
                  <Button Content="Save" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OverviewSaveSettingsButton"/>
                  <Button Content="Restore Proxy" Command="{Binding RestoreProxyCommand}" Margin="0,0,8,0"/>
                  <Button Content="Proxy Addr" Command="{Binding CopyProxyCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="CopyProxyAddressButton"/>
                  <Button Content="Copy Status" Command="{Binding CopyOverviewStatusCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="CopyOverviewStatusButton"/>
                  <Button Content="Restart" Command="{Binding RestartCommand}"/>
                </WrapPanel>
                <TextBlock Classes="caption" Text="Network"/>
                <WrapPanel>
                  <Button Content="Test Network" Command="{Binding RunOverviewNetworkTestCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OverviewTestNetworkButton"/>
                  <Button Content="Diagnostics" Command="{Binding OpenDiagnosticsCommand}" automation:AutomationProperties.AutomationId="OverviewOpenDiagnosticsButton"/>
                </WrapPanel>
                <TextBlock Classes="caption" Text="Open"/>
                <WrapPanel>
                  <Button Content="Profiles" Command="{Binding OpenProfilesCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OpenProfilesButton"/>
                  <Button Content="Subscriptions" Command="{Binding OpenSubscriptionsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OpenSubscriptionsButton"/>
                  <Button Content="Logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OpenLogsButton"/>
                  <Button Content="Diagnostics" Command="{Binding OpenDiagnosticsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="OpenDiagnosticsButton"/>
                  <Button Content="Settings" Command="{Binding OpenSettingsCommand}" automation:AutomationProperties.AutomationId="OpenSettingsButton"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewMetrics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="metric">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="caption"/>
                    <TextBlock Grid.Row="1" Text="{Binding Value}" Classes="metricValue" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="2" ColumnDefinitions="1.1*,1.1*,1.4*" ColumnSpacing="12">
            <Border Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Listeners"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ListenerRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Channels"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ChannelRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel">
              <Grid RowDefinitions="Auto,*,Auto,120">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Recent Logs" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyOverviewRecentLogsCommand}" automation:AutomationProperties.AutomationId="CopyOverviewRecentLogsButton"/>
                </Grid>
                <TextBox Grid.Row="1" Text="{Binding LogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="OverviewRecentLogsTextBox"/>
                <Grid Grid.Row="2" Margin="0,10,0,6" ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="section" Text="Runtime Details" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyOverviewRuntimeDetailsCommand}" Margin="0,0,8,0" automation:AutomationProperties.AutomationId="CopyOverviewRuntimeDetailsButton"/>
                  <Button Grid.Column="2" Content="Copy Metrics" Command="{Binding CopyRuntimeMetricsCommand}" automation:AutomationProperties.AutomationId="CopyRuntimeMetricsButton"/>
                </Grid>
                <TextBox Grid.Row="3" Text="{Binding StatusText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="OverviewRuntimeDetailsTextBox"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Profiles" automation:AutomationProperties.AutomationId="ProfilesTab">
        <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ProfileSearchText}" PlaceholderText="Search profiles" automation:AutomationProperties.AutomationId="ProfileSearchTextBox"/>
                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearProfileSearchCommand}" automation:AutomationProperties.AutomationId="ClearProfileSearchButton"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Text="Sort" Classes="caption" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileSortOptions}" SelectedItem="{Binding SelectedProfileSort}" MinHeight="30" automation:AutomationProperties.AutomationId="ProfileSortComboBox"/>
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="New" Command="{Binding NewProfileCommand}" automation:AutomationProperties.AutomationId="NewProfileButton"/>
                <Button Content="Copy" Command="{Binding DuplicateProfileCommand}" automation:AutomationProperties.AutomationId="DuplicateProfileButton"/>
                <Button Content="Delete" Command="{Binding DeleteProfileCommand}" automation:AutomationProperties.AutomationId="DeleteProfileButton"/>
                <Button Content="Test Selected" Command="{Binding TestSelectedProfileEndpointCommand}" automation:AutomationProperties.AutomationId="TestSelectedProfileButton"/>
                <Button Content="Test Visible" Command="{Binding TestVisibleProfilesCommand}" automation:AutomationProperties.AutomationId="TestVisibleProfilesButton"/>
                <Button Content="Test + Fastest" Command="{Binding TestAndSelectFastestProfileCommand}" automation:AutomationProperties.AutomationId="TestAndSelectFastestProfileButton"/>
                <Button Content="Fastest" Command="{Binding SelectFastestProfileCommand}" automation:AutomationProperties.AutomationId="SelectFastestProfileButton"/>
                <Button Content="Clear Tests" Command="{Binding ClearVisibleProfileEndpointTestsCommand}" automation:AutomationProperties.AutomationId="ClearEndpointTestsButton"/>
                <Button Content="Startup" Command="{Binding UseSelectedProfileAtStartupCommand}" automation:AutomationProperties.AutomationId="UseStartupProfileButton"/>
                <Button Content="Clear Startup" Command="{Binding ClearStartupProfileCommand}" automation:AutomationProperties.AutomationId="ClearStartupProfileButton"/>
              </WrapPanel>
              <TextBlock Text="{Binding StartupProfileSummary}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="StartupProfileSummaryTextBlock"/>
              <TextBlock Text="{Binding ProfileBatchTestText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileBatchTestTextBlock"/>
              <TextBlock Text="{Binding ProfileSummaryText}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileSummaryTextBlock"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding FilteredProfiles}" SelectedItem="{Binding SelectedProfile}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileListItemName"/>
                      <Border Grid.Column="1" Background="{Binding ValidationBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding ValidationState}" Foreground="{Binding ValidationBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="ProfileListItemValidationState"/>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding ListSubtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <Border Grid.Row="1" Grid.Column="1" Background="{Binding EndpointBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding EndpointTestState}" Foreground="{Binding EndpointBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="ProfileListItemEndpointState"/>
                      </Border>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ValidationDetail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding EndpointTestDetail}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileListItemEndpointDetail"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,120,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,160,160" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.Name}" PlaceholderText="Profile name" automation:AutomationProperties.AutomationId="ProfileNameTextBox"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileKinds}" SelectedItem="{Binding SelectedProfile.Kind}"/>
              <TextBox Grid.Column="2" Text="{Binding SelectedProfile.Source}" PlaceholderText="source"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="2*,2*,120,120,160" ColumnSpacing="8">
              <TextBox Text="{Binding ProfileListen}" PlaceholderText="listen" automation:AutomationProperties.AutomationId="ProfileListenTextBox"/>
              <TextBox Grid.Column="1" Text="{Binding ProfileForward}" PlaceholderText="forward" automation:AutomationProperties.AutomationId="ProfileForwardTextBox"/>
              <NumericUpDown Grid.Column="2" Value="{Binding ProfileConnections}" Minimum="1" Maximum="32"/>
              <CheckBox Grid.Column="3" IsChecked="{Binding ProfileFallback}" Content="fallback" VerticalAlignment="Center"/>
              <TextBox Grid.Column="4" Text="{Binding ProfileMetrics}" PlaceholderText="metrics"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.SecretRef}" PlaceholderText="secret ref, e.g. profile-token"/>
              <TextBox Grid.Column="1" Text="{Binding SecretValue}" PasswordChar="*" PlaceholderText="profile secret saved with DPAPI" automation:AutomationProperties.AutomationId="ProfileSecretTextBox"/>
            </Grid>
            <WrapPanel Grid.Row="3">
              <Button Content="Apply Form" Command="{Binding ApplyFormCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="ApplyProfileFormButton"/>
              <Button Content="Save" Command="{Binding SaveProfileCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="SaveProfileButton"/>
              <Button Content="Validate" Command="{Binding ValidateProfileCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="ValidateProfileButton"/>
              <Button Content="Format" Command="{Binding FormatProfileCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="FormatProfileButton"/>
              <Button Content="Import File" Click="ImportFile_OnClick" Margin="0,0,8,8"/>
              <Button Content="Import Clipboard" Click="ImportClipboard_OnClick" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="ImportProfileClipboardButton"/>
              <Button Content="Export" Click="ExportProfile_OnClick" Margin="0,0,8,8"/>
              <Button Content="Copy Summary" Command="{Binding CopyProfileSummaryCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="CopyProfileSummaryButton"/>
              <Button Content="Copy Config" Command="{Binding CopyProfileConfigCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="CopyProfileConfigButton"/>
              <Button Content="Copy Issues" Command="{Binding CopyProfileIssuesCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="CopyProfileIssuesButton"/>
            </WrapPanel>
            <Border Grid.Row="4" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Profile Checks"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ProfileIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6" ColumnDefinitions="90,80,*">
                          <TextBlock Text="{Binding Field}" Classes="caption"/>
                          <TextBlock Grid.Column="1" Text="{Binding Severity}" Classes="caption"/>
                          <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <TextBox Grid.Row="5" Text="{Binding SelectedProfile.CoreConfigJson}" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="ProfileJsonTextBox"/>
            <TextBlock Grid.Row="6" Text="{Binding SelectedProfile.LastValidationError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Subscriptions" automation:AutomationProperties.AutomationId="SubscriptionsTab">
        <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
              <TextBox Text="{Binding SubscriptionSearchText}" PlaceholderText="Search subscriptions" automation:AutomationProperties.AutomationId="SubscriptionSearchTextBox"/>
              <Button Grid.Column="1" Content="Clear" Command="{Binding ClearSubscriptionSearchCommand}" automation:AutomationProperties.AutomationId="ClearSubscriptionSearchButton"/>
            </Grid>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
              <TextBlock Text="Sort" Classes="caption" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding SubscriptionSortOptions}" SelectedItem="{Binding SelectedSubscriptionSort}" MinHeight="30" automation:AutomationProperties.AutomationId="SubscriptionSortComboBox"/>
            </Grid>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <Button Content="New" Command="{Binding NewSubscriptionCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="NewSubscriptionButton"/>
              <Button Content="Update" Command="{Binding RefreshSubscriptionCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="UpdateSubscriptionButton"/>
              <Button Content="Update All" Command="{Binding RefreshAllSubscriptionsCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="UpdateAllSubscriptionsButton"/>
              <Button Content="Save" Command="{Binding SaveSubscriptionCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="SaveSubscriptionButton"/>
              <Button Content="Delete" Command="{Binding DeleteSubscriptionCommand}" Margin="0,0,8,8" automation:AutomationProperties.AutomationId="DeleteSubscriptionButton"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionSummaryText}" Classes="caption" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="SubscriptionSummaryTextBlock"/>
            <ListBox ItemsSource="{Binding FilteredSubscriptions}" SelectedItem="{Binding SelectedSubscription}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="SubscriptionListItemName"/>
                      <Border Grid.Column="1" Background="{Binding UpdateBadgeBackground}" CornerRadius="4" Padding="7,2">
                        <TextBlock Text="{Binding UpdateState}" Foreground="{Binding UpdateBadgeForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="SubscriptionListItemState"/>
                      </Border>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ListSubtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding UpdateDetail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,150" RowSpacing="10">
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
              <TextBlock Text="Name" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding SelectedSubscription.DisplayName}" PlaceholderText="Subscription name" automation:AutomationProperties.AutomationId="SubscriptionNameTextBox"/>
              <TextBlock Grid.Row="1" Text="URL" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSubscription.Url}" PlaceholderText="https://example.com/subscription.json" automation:AutomationProperties.AutomationId="SubscriptionUrlTextBox"/>
              <TextBlock Grid.Row="2" Text="Update interval minutes" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SelectedSubscription.UpdateIntervalMinutes}" Minimum="1" Maximum="10080"/>
              <TextBlock Grid.Row="3" Text="Trust policy" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SubscriptionTrustPolicies}" SelectedItem="{Binding SelectedSubscription.TrustPolicy}"/>
            </Grid>
            <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="8">
              <Button Content="Update Now" Command="{Binding RefreshSubscriptionCommand}" automation:AutomationProperties.AutomationId="UpdateSubscriptionNowButton"/>
              <Button Content="Update All" Command="{Binding RefreshAllSubscriptionsCommand}" automation:AutomationProperties.AutomationId="UpdateAllSubscriptionsNowButton"/>
              <Button Content="Save Subscription" Command="{Binding SaveSubscriptionCommand}" automation:AutomationProperties.AutomationId="SaveSubscriptionDetailsButton"/>
              <Button Content="Copy Source" Command="{Binding CopySubscriptionSourceCommand}" automation:AutomationProperties.AutomationId="CopySubscriptionSourceButton"/>
              <Button Content="Copy Result" Command="{Binding CopySubscriptionStatusCommand}" automation:AutomationProperties.AutomationId="CopySubscriptionStatusButton"/>
            </WrapPanel>
            <TextBox Grid.Row="2" Text="{Binding SubscriptionStatusText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="SubscriptionStatusTextBox"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Logs" automation:AutomationProperties.AutomationId="LogsTab">
        <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Refresh Diagnostics" Command="{Binding RefreshDiagnosticsCommand}" automation:AutomationProperties.AutomationId="LogsRefreshDiagnosticsButton"/>
            <Button Content="Export Diagnostics" Click="ExportDiagnostics_OnClick" automation:AutomationProperties.AutomationId="ExportDiagnosticsButton"/>
            <ComboBox Width="150" ItemsSource="{Binding LogLevelFilters}" SelectedItem="{Binding SelectedLogLevelFilter}" automation:AutomationProperties.AutomationId="LogLevelFilterComboBox"/>
            <TextBox Width="390" Text="{Binding LogFilterText}" PlaceholderText="Filter logs, /regex/" automation:AutomationProperties.AutomationId="LogFilterTextBox"/>
            <Button Content="Clear Filters" Command="{Binding ClearLogFiltersCommand}" automation:AutomationProperties.AutomationId="ClearLogFiltersButton"/>
            <Button Content="Copy Logs" Command="{Binding CopyFilteredLogsCommand}" automation:AutomationProperties.AutomationId="CopyFilteredLogsButton"/>
          </WrapPanel>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Background="{Binding LogFilterBadgeBackground}" CornerRadius="4" Padding="7,2">
              <TextBlock Text="{Binding LogFilterBadgeText}" Foreground="{Binding LogFilterBadgeForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="LogFilterBadgeText"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding LogFilterSummary}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="LogFilterSummaryText"/>
          </Grid>
          <TextBox Grid.Row="2" Text="{Binding FilteredLogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="FilteredLogTextBox"/>
        </Grid>
      </TabItem>

      <TabItem Header="Diagnostics" automation:AutomationProperties.AutomationId="DiagnosticsTab">
        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,88,Auto,Auto,88,132,*" RowSpacing="10">
          <StackPanel Spacing="8">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="Run All" Command="{Binding RunAllDiagnosticsCommand}" automation:AutomationProperties.AutomationId="RunAllDiagnosticsButton"/>
              <Button Content="Clear Tests" Command="{Binding ClearDiagnosticsTestsCommand}" automation:AutomationProperties.AutomationId="ClearDiagnosticsTestsButton"/>
              <Button Content="Run Checks" Command="{Binding RefreshDiagnosticsCommand}" automation:AutomationProperties.AutomationId="RunDiagnosticsButton"/>
              <Button Content="Copy Summary" Command="{Binding CopyDiagnosticsSummaryCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsSummaryButton"/>
              <Button Content="Copy Report" Command="{Binding CopyDiagnosticsReportCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsReportButton"/>
              <Button Content="Export Zip" Click="ExportDiagnostics_OnClick" automation:AutomationProperties.AutomationId="ExportDiagnosticsZipButton"/>
              <Button Content="Restore Proxy" Command="{Binding RestoreProxyCommand}"/>
              <Button Content="Open Logs" Command="{Binding OpenLogsFolderCommand}"/>
              <Button Content="Copy Ports" Command="{Binding CopyDiagnosticsPortsCommand}" automation:AutomationProperties.AutomationId="CopyDiagnosticsPortsButton"/>
            </WrapPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Border Background="{Binding DiagnosticsPortBackground}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding DiagnosticsPortStatus}" Foreground="{Binding DiagnosticsPortForeground}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsPortStatusText"/>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding DiagnosticsPortDetail}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsPortDetailText"/>
              <TextBlock Grid.Column="2" Text="{Binding DiagnosticsLastRunText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DiagnosticsLastRunText"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="90,*" ColumnSpacing="8">
            <TextBlock Text="Target" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkTestTargets}" SelectedItem="{Binding SelectedNetworkTestTarget}" MinHeight="30" automation:AutomationProperties.AutomationId="NetworkTestTargetComboBox"/>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="90,*,Auto,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Test URL" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding NetworkTestUrl}" automation:AutomationProperties.AutomationId="NetworkTestUrlTextBox"/>
            <Button Grid.Column="2" Content="Test Network" Command="{Binding TestNetworkCommand}" automation:AutomationProperties.AutomationId="TestNetworkButton"/>
            <Button Grid.Column="3" Content="Copy Result" Command="{Binding CopyNetworkTestResultCommand}" automation:AutomationProperties.AutomationId="CopyNetworkTestResultButton"/>
            <Button Grid.Column="4" Content="Clear" Command="{Binding ClearNetworkTestCommand}" automation:AutomationProperties.AutomationId="ClearNetworkTestButton"/>
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Border Background="{Binding NetworkDirectRouteBackground}" CornerRadius="4" Padding="8,5">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding NetworkDirectRouteStatus}" Foreground="{Binding NetworkDirectRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkDirectRouteStatusText"/>
                <TextBlock Grid.Row="1" Text="{Binding NetworkDirectRouteDetail}" Foreground="{Binding NetworkDirectRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkDirectRouteDetailText"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="{Binding NetworkProxyRouteBackground}" CornerRadius="4" Padding="8,5">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding NetworkProxyRouteStatus}" Foreground="{Binding NetworkProxyRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkProxyRouteStatusText"/>
                <TextBlock Grid.Row="1" Text="{Binding NetworkProxyRouteDetail}" Foreground="{Binding NetworkProxyRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="NetworkProxyRouteDetailText"/>
              </Grid>
            </Border>
          </Grid>
          <TextBox Grid.Row="4" Text="{Binding NetworkTestText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="NetworkTestResultTextBox"/>
          <WrapPanel Grid.Row="5" ItemSpacing="8" LineSpacing="8">
            <Button Content="Test Forward" Command="{Binding TestProfileEndpointCommand}" automation:AutomationProperties.AutomationId="TestProfileEndpointButton"/>
            <Button Content="Copy Forward" Command="{Binding CopyProfileEndpointTestResultCommand}" automation:AutomationProperties.AutomationId="CopyProfileEndpointTestResultButton"/>
            <Button Content="Clear Forward" Command="{Binding ClearProfileEndpointTestCommand}" automation:AutomationProperties.AutomationId="ClearProfileEndpointTestButton"/>
            <TextBlock Text="{Binding ProfileEndpointTestLastRunText}" Classes="caption" VerticalAlignment="Center" automation:AutomationProperties.AutomationId="ProfileEndpointLastRunText"/>
          </WrapPanel>
          <Border Grid.Row="6" Background="{Binding ProfileEndpointRouteBackground}" CornerRadius="4" Padding="8,5">
            <Grid RowDefinitions="Auto,Auto">
              <TextBlock Text="{Binding ProfileEndpointRouteStatus}" Foreground="{Binding ProfileEndpointRouteForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileEndpointRouteStatusText"/>
              <TextBlock Grid.Row="1" Text="{Binding ProfileEndpointRouteDetail}" Foreground="{Binding ProfileEndpointRouteForeground}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="ProfileEndpointRouteDetailText"/>
            </Grid>
          </Border>
          <TextBox Grid.Row="7" Text="{Binding ProfileEndpointTestText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="ProfileEndpointTestResultTextBox"/>
          <TextBox Grid.Row="8" Text="{Binding DiagnosticsSummaryText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="DiagnosticsSummaryTextBox"/>
          <TextBox Grid.Row="9" Text="{Binding DiagnosticsText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="DiagnosticsReportTextBox"/>
        </Grid>
      </TabItem>

      <TabItem Header="Settings" automation:AutomationProperties.AutomationId="SettingsTab">
        <ScrollViewer>
          <Grid Margin="16" ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
            <TextBlock Text="Launch at login" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.LaunchAtLogin}"/>
            <TextBlock Grid.Row="1" Text="Start minimized" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.StartMinimized}"/>
            <TextBlock Grid.Row="2" Text="Auto-connect selected profile" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AutoConnectSelectedProfile}"/>
            <TextBlock Grid.Row="3" Text="Startup delay seconds" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.StartupDelaySeconds}" Minimum="0" Maximum="120"/>
            <TextBlock Grid.Row="4" Text="Theme" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"/>
            <TextBlock Grid.Row="5" Text="Language" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.Language}"/>
            <TextBlock Grid.Row="6" Text="PAC bypass rules" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.PacBypassRules}"/>
            <TextBlock Grid.Row="7" Text="Log retention days" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Settings.LogRetentionDays}" Minimum="1" Maximum="365"/>
            <TextBlock Grid.Row="8" Text="Update channel" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding SelectedUpdateChannel}"/>
            <TextBlock Grid.Row="9" Text="Core executable" VerticalAlignment="Center"/>
            <Grid Grid.Row="9" Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBox Text="{Binding CorePath}" PlaceholderText="Auto-detect or full path to x-tunnel.exe" automation:AutomationProperties.AutomationId="SettingsCorePathTextBox"/>
              <Button Grid.Column="1" Content="Use Detected" Command="{Binding UseDetectedCorePathCommand}" automation:AutomationProperties.AutomationId="UseDetectedCorePathButton"/>
              <Button Grid.Column="2" Content="Copy Path" Command="{Binding CopyCorePathCommand}" automation:AutomationProperties.AutomationId="CopyCorePathButton"/>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DetectedCorePath}" Classes="caption" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="DetectedCorePathTextBlock"/>
              <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Background="{Binding CorePathStatusBackground}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CorePathStatus}" Foreground="{Binding CorePathStatusForeground}" FontSize="11" FontWeight="SemiBold" automation:AutomationProperties.AutomationId="CorePathStatusText"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding CorePathStatusDetail}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" automation:AutomationProperties.AutomationId="CorePathStatusDetailText"/>
              </Grid>
            </Grid>
            <TextBlock Grid.Row="10" Text="Local folders" VerticalAlignment="Center"/>
            <WrapPanel Grid.Row="10" Grid.Column="1" ItemSpacing="8" LineSpacing="8">
              <Button Content="Copy Folders" Command="{Binding CopySettingsFoldersCommand}" automation:AutomationProperties.AutomationId="CopySettingsFoldersButton"/>
              <Button Content="App Data" Command="{Binding OpenDataFolderCommand}"/>
              <Button Content="Profiles" Command="{Binding OpenProfilesFolderCommand}"/>
              <Button Content="Logs" Command="{Binding OpenLogsFolderCommand}"/>
              <Button Content="Runtime" Command="{Binding OpenRuntimeFolderCommand}"/>
            </WrapPanel>
            <Button Grid.Row="11" Grid.Column="1" HorizontalAlignment="Left" Content="Save Settings" Command="{Binding SaveSettingsCommand}" automation:AutomationProperties.AutomationId="SaveSettingsButton"/>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
