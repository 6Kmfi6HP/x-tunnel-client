<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XTunnelClient.App.MainWindow"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        Title="x-tunnel Client">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.metricValue">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Width" Value="242"/>
      <Setter Property="Height" Value="94"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel Background="#F5F7FA">
    <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#D8DEE8" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="x-tunnel" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding RuntimeState}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding ErrorText}" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,0"/>
        <Button Grid.Column="3" Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,8,0"/>
        <Button Grid.Column="4" Content="Diagnostics" Command="{Binding RefreshDiagnosticsCommand}"/>
      </Grid>
    </Border>

    <TabControl>
      <TabItem Header="Overview">
        <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
          <Border Classes="panel">
            <Grid ColumnDefinitions="*,360" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ConnectionHeading}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ConnectionDetail}" Classes="caption"/>
                <Grid Margin="0,10,0,0" ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Profile" Classes="caption"/>
                  <TextBlock Grid.Column="1" Text="{Binding ActiveProfileSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Text="Core" Classes="caption"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreSummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" Text="Proxy" Classes="caption"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProxySummary}"/>
                  <TextBlock Grid.Row="3" Text="Local" Classes="caption"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalProxySummary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="4" Text="Validation" Classes="caption"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ValidationSummary}" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="section" Text="Control"/>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberBinding="{Binding Name}" MinHeight="34"/>
                <ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding SelectedProxyMode}" MinHeight="34"/>
                <TextBox Text="{Binding Settings.CorePath}" PlaceholderText="Auto-detect or full path to x-tunnel.exe"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                  <Button Content="Save" Command="{Binding SaveSettingsCommand}"/>
                  <Button Grid.Column="1" Content="Restore Proxy" Command="{Binding RestoreProxyCommand}"/>
                  <Button Grid.Column="2" Content="Proxy Addr" Command="{Binding CopyProxyCommand}"/>
                  <Button Grid.Column="3" Content="Restart" Command="{Binding RestartCommand}"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewMetrics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="metric">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="caption"/>
                    <TextBlock Grid.Row="1" Text="{Binding Value}" Classes="metricValue" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="2" ColumnDefinitions="1.1*,1.1*,1.4*" ColumnSpacing="12">
            <Border Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Listeners"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ListenerRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Channels"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ChannelRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto" ColumnDefinitions="88,*">
                        <TextBlock Text="{Binding Name}" Classes="caption"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" Classes="caption"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel">
              <Grid RowDefinitions="Auto,*,Auto,120">
                <TextBlock Classes="section" Text="Recent Logs"/>
                <TextBox Grid.Row="1" Text="{Binding LogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="2" Margin="0,10,0,6" Classes="section" Text="Runtime Details"/>
                <TextBox Grid.Row="3" Text="{Binding StatusText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Profiles">
        <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <Button Content="New" Command="{Binding NewProfileCommand}"/>
              <Button Content="Copy" Command="{Binding DuplicateProfileCommand}"/>
              <Button Content="Delete" Command="{Binding DeleteProfileCommand}"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberBinding="{Binding Name}"/>
          </DockPanel>

          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,120,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,160,160" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.Name}" PlaceholderText="Profile name"/>
              <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedProfile.Kind}">
                <ComboBoxItem Content="client"/>
                <ComboBoxItem Content="server"/>
              </ComboBox>
              <TextBox Grid.Column="2" Text="{Binding SelectedProfile.Source}" PlaceholderText="source"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="2*,2*,120,120,160" ColumnSpacing="8">
              <TextBox Text="{Binding ProfileListen}" PlaceholderText="listen"/>
              <TextBox Grid.Column="1" Text="{Binding ProfileForward}" PlaceholderText="forward"/>
              <NumericUpDown Grid.Column="2" Value="{Binding ProfileConnections}" Minimum="1" Maximum="32"/>
              <CheckBox Grid.Column="3" IsChecked="{Binding ProfileFallback}" Content="fallback" VerticalAlignment="Center"/>
              <TextBox Grid.Column="4" Text="{Binding ProfileMetrics}" PlaceholderText="metrics"/>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedProfile.SecretRef}" PlaceholderText="secret ref, e.g. profile-token"/>
              <TextBox Grid.Column="1" Text="{Binding SecretValue}" PasswordChar="*" PlaceholderText="profile secret saved with DPAPI"/>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
              <Button Content="Apply Form" Command="{Binding ApplyFormCommand}"/>
              <Button Content="Save" Command="{Binding SaveProfileCommand}"/>
              <Button Content="Validate" Command="{Binding ValidateProfileCommand}"/>
              <Button Content="Format" Command="{Binding FormatProfileCommand}"/>
              <Button Content="Import File" Click="ImportFile_OnClick"/>
              <Button Content="Import Clipboard" Click="ImportClipboard_OnClick"/>
              <Button Content="Export" Click="ExportProfile_OnClick"/>
            </StackPanel>
            <Border Grid.Row="4" Classes="panel">
              <Grid RowDefinitions="Auto,*">
                <TextBlock Classes="section" Text="Profile Checks"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ProfileIssues}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6" ColumnDefinitions="90,80,*">
                          <TextBlock Text="{Binding Field}" Classes="caption"/>
                          <TextBlock Grid.Column="1" Text="{Binding Severity}" Classes="caption"/>
                          <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <TextBox Grid.Row="5" Text="{Binding SelectedProfile.CoreConfigJson}" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <TextBlock Grid.Row="6" Text="{Binding SelectedProfile.LastValidationError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Logs">
        <Grid Margin="16" RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh Diagnostics" Command="{Binding RefreshDiagnosticsCommand}"/>
            <Button Content="Export Diagnostics" Click="ExportDiagnostics_OnClick"/>
          </StackPanel>
          <TextBox Grid.Row="1" Margin="0,10,0,0" Text="{Binding LogText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>

      <TabItem Header="Diagnostics">
        <Grid Margin="16" RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Run Checks" Command="{Binding RefreshDiagnosticsCommand}"/>
            <Button Content="Export Zip" Click="ExportDiagnostics_OnClick"/>
            <Button Content="Restore Proxy" Command="{Binding RestoreProxyCommand}"/>
          </StackPanel>
          <TextBox Grid.Row="1" Margin="0,10,0,0" Text="{Binding DiagnosticsText}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <ScrollViewer>
          <Grid Margin="16" ColumnDefinitions="260,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
            <TextBlock Text="Launch at login" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.LaunchAtLogin}"/>
            <TextBlock Grid.Row="1" Text="Start minimized" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.StartMinimized}"/>
            <TextBlock Grid.Row="2" Text="Theme" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Settings.Theme}">
              <ComboBoxItem Content="system"/>
              <ComboBoxItem Content="light"/>
              <ComboBoxItem Content="dark"/>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="Language" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Language}"/>
            <TextBlock Grid.Row="4" Text="PAC bypass rules" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.PacBypassRules}"/>
            <TextBlock Grid.Row="5" Text="Log retention days" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Settings.LogRetentionDays}" Minimum="1" Maximum="365"/>
            <TextBlock Grid.Row="6" Text="Update channel" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Settings.UpdateChannel}">
              <ComboBoxItem Content="stable"/>
              <ComboBoxItem Content="beta"/>
              <ComboBoxItem Content="disabled"/>
            </ComboBox>
            <Button Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Content="Save Settings" Command="{Binding SaveSettingsCommand}"/>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
